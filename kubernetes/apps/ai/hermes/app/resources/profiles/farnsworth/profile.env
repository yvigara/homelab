# Rendered to $HERMES_HOME/profiles/farnsworth/.env by profiles-init.sh.
#
# Only what must differ per profile. Everything shared - model provider
# key, MEMINI_BASE_URL, SEARXNG_URL, git identity, MCP credentials - comes
# from the container env, which every profile inherits.
#
# Nothing secret: this file is a ConfigMap in git. The secret half of the
# assembled .env - this agent's own Buzz identity - is appended from the
# hermes-profile-env Secret by profiles-init.sh.

# Profile boundary is memory boundary.
MEMINI_NAMESPACE="hermes/farnsworth"

# This agent runs a Buzz gateway but no OpenAI-compatible API server: every
# gateway defaults to port 8642, and only the default agent binds it.
API_SERVER_ENABLED="false"
