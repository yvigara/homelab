# Rendered to $HERMES_HOME/profiles/coder/.env by profiles-init.sh.
#
# Only settings that must differ per profile belong here. Everything shared -
# model provider keys, MEMINI_BASE_URL, SEARXNG_URL, git identity, MCP
# credentials - comes from the pod's container env, which every profile in this
# pod inherits.
#
# Nothing secret: this file is a ConfigMap in git. A profile that needs its own
# credentials gets them the way the default profile does, from an ExternalSecret
# rendered as a whole dotenv document (see externalsecret.yaml).

# Memory is namespaced per profile so this agent's memini recall stays out of
# the default agent's, and vice versa.
MEMINI_NAMESPACE="hermes-coder"

# No second gateway process: no OpenAI-compatible API server to bind a port, and
# no chat platform to claim a bot token.
API_SERVER_ENABLED="false"
WHATSAPP_ENABLED="false"
